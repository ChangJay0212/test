# AI Agent Teaching System Environment Configuration
# Copy this file to .env and customize the values as needed

# ================================
# LLM API Configuration
# ================================

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration  
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# ================================
# Token Cost Configuration (USD per 1K tokens)
# ================================

# Gemini Pricing
GEMINI_INPUT_COST_PER_1K=0.0005
GEMINI_OUTPUT_COST_PER_1K=0.0015

# Ollama Pricing (free for local deployment)
OLLAMA_COMPUTE_COST_PER_1K=0.0

# OpenAI Pricing (for future use)
OPENAI_INPUT_COST_PER_1K=0.0010
OPENAI_OUTPUT_COST_PER_1K=0.0020

# Claude Pricing (for future use)
CLAUDE_INPUT_COST_PER_1K=0.0008
CLAUDE_OUTPUT_COST_PER_1K=0.0024

# ================================
# Cost Management Settings
# ================================

# Alert when daily cost exceeds this amount (USD)
COST_ALERT_THRESHOLD=10.0

# Enable/disable cost tracking
COST_TRACKING_ENABLED=true

# ================================
# Kafka Configuration
# ================================

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ================================
# External Tool API Keys
# ================================

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here

# Web Search API (SerpAPI)
SERPAPI_KEY=your_serpapi_key_here
